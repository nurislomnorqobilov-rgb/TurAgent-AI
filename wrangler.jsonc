{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "turagent-ai",
	"main": "src/index.js",
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/assets/hero-real.mp4"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "turagent-ai-db",
			"database_id": "1ff21275-e584-4ac9-bd32-d06994400d9f",
			"migrations_dir": "migrations"
		},
		{
			"binding": "turagent_ai_db",
			"database_name": "turagent-ai-db",
			"database_id": "1ff21275-e584-4ac9-bd32-d06994400d9f",
			"remote": true
		}
	],
	"vars": {
		"GEMINI_MODEL": "gemini-3.5-flash-lite",
		"CURRENCY_RATE": "12800"
	}
}