{
  "name":"turagent-ai-cloudflare",
  "version":"6.0.0",
  "type":"module",
  "private":true,
  "scripts":{
    "dev":"wrangler dev --local",
    "deploy":"wrangler deploy",
    "db:local":"wrangler d1 migrations apply DB --local",
    "db:remote":"wrangler d1 migrations apply DB --remote",
    "test":"node --test tests/*.test.mjs",
    "check":"node --check src/index.js && node --check public/app.js && node --check public/i18n.js"
  },
  "devDependencies":{"wrangler":"^4.151.1"}
}
