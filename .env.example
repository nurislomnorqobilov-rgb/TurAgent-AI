# Copy to .env. NEVER commit or share the real .env!
POSTGRES_USER=turagent
POSTGRES_DB=turagent
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LONG_PASSWORD
PUBLIC_URL=http://localhost:8000
# One-time bootstrap secret to create first admin (minimum 24 random characters recommended)
ADMIN_SETUP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SETUP_SECRET
# Optional: enable Gemini site assistant; API key, quota, region and model permissions are managed by Google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: Google Cloud console OAuth Web credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional SMTP for password reset and booking/contact alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=assalomualaykum@gmail.com
